import math
import csv


BUILTIN_FUNCTIONS = {
    "1": ("x^2 + 2x + 1", lambda x: x**2 + 2*x + 1),
    "2": ("sin(x)",       math.sin),
    "3": ("exp(-x)",      lambda x: math.exp(-x)),
    "4": ("sqrt(x)",      lambda x: math.sqrt(x)),
    "5": ("1/x",          lambda x: 1.0 / x),
}

# Разрешённые имена для пользовательского выражения
SAFE_NAMES = {name: getattr(math, name) for name in dir(math) if not name.startswith("_")}
SAFE_NAMES["abs"] = abs


def choose_function():
    print("Выберите функцию из списка или введите своё выражение от x:")
    for key, (descr, _) in BUILTIN_FUNCTIONS.items():
        print(f"  {key}. f(x) = {descr}")
    print("  Или напишите выражение, например: x**2 * sin(x)")

    while True:
        raw = input("Ваш выбор / выражение: ").strip()
        if raw in BUILTIN_FUNCTIONS:
            descr, func = BUILTIN_FUNCTIONS[raw]
            return descr, func

        try:
            code = compile(raw, "<user expression>", "eval")
        except SyntaxError as e:
            print(f"Синтаксическая ошибка: {e.msg}. Пример корректного ввода: x**2 + 3*x")
            continue

        for name in code.co_names:
            if name != "x" and name not in SAFE_NAMES:
                print(f"Неизвестное имя: {name}. Разрешены только x и функции модуля math.")
                break
        else:
            def f(x, _code=code):
                return eval(_code, {"__builtins__": {}}, {**SAFE_NAMES, "x": x})
            return raw, f


def input_float(prompt, a=None, b=None):
    while True:
        try:
            value = float(input(prompt).replace(",", "."))
        except ValueError:
            print("Нужно число, например 0 или 2.5")
            continue
        if (a is not None and value < a) or (b is not None and value > b):
            print(f"Значение должно быть в диапазоне от {a} до {b}")
            continue
        return value


def input_int(prompt):
    while True:
        try:
            value = int(input(prompt))
            if value <= 0:
                raise ValueError
            return value
        except ValueError:
            print("Нужно целое положительное число")


METHODS = {
    "1": ("Левые прямоугольники",   "left"),
    "2": ("Правые прямоугольники",  "right"),
    "3": ("Средние прямоугольники", "middle"),
    "4": ("Трапеции",               "trapezoid"),
    "5": ("Симпсон",                "simpson"),
}


def choose_method():
    for key, (name, _) in METHODS.items():
        print(f"  {key}. {name}")
    while True:
        choice = input("Метод интегрирования: ").strip()
        if choice in METHODS:
            return METHODS[choice][1]
        print("Введите число от 1 до 5")


def integrate(f, a, b, n, method):
    h = (b - a) / n
    points = []          # список (x, значение или None)
    total = 0.0

    def safe_f(x):
        try:
            return f(x)
        except (ZeroDivisionError, ValueError, OverflowError) as e:
            return ("error", type(e).__name__)

    if method in ("left", "right", "middle"):
        for i in range(n):
            if method == "left":
                x = a + i * h
            elif method == "right":
                x = a + (i + 1) * h
            else:
                x = a + (i + 0.5) * h
            val = safe_f(x)
            points.append((x, val))
            if isinstance(val, tuple):
                continue
            total += val
        result = total * h

    elif method == "trapezoid":
        for i in range(n + 1):
            x = a + i * h
            val = safe_f(x)
            points.append((x, val))
        for i in range(n):
            fa, fb = points[i][1], points[i + 1][1]
            if isinstance(fa, tuple) or isinstance(fb, tuple):
                continue
            total += (fa + fb) / 2
        result = total * h

    else:
        if n % 2 == 1:
            n += 1
            h = (b - a) / n
        for i in range(n + 1):
            x = a + i * h
            points.append((x, safe_f(x)))
        values = [p[1] for p in points]
        for i in range(n + 1):
            if isinstance(values[i], tuple):
                continue
            if i in (0, n):
                total += values[i]
            elif i % 2 == 1:
                total += 4 * values[i]
            else:
                total += 2 * values[i]
        result = total * h / 3

    return result, points, n


def print_table(points):
    print(f"{'i':>5} | {'x':>12} | {'f(x)':>14}")
    print("-" * 37)
    for i, (x, val) in enumerate(points):
        if isinstance(val, tuple):
            print(f"{i:>5} | {x:>12.5f} | {'ОШИБКА: ' + val[1]:>14}")
        else:
            print(f"{i:>5} | {x:>12.5f} | {val:>14.6f}")
    errors = sum(1 for _, v in points if isinstance(v, tuple))
    if errors:
        print(f"Внимание: в {errors} точках функция не определена, результат может быть неточным.")


def save_result(points, integral, func_descr, a, b, n, method_name):
    print("Сохранить результат?")
    print("  1. result.csv")
    print("  2. result.txt")
    print("  3. Не сохранять")
    choice = input("Ваш выбор: ").strip()

    if choice == "1":
        with open("result.csv", "w", newline="", encoding="utf-8-sig") as file:
            writer = csv.writer(file, delimiter=";")
            writer.writerow(["i", "x", "f(x)"])
            for i, (x, val) in enumerate(points):
                if isinstance(val, tuple):
                    writer.writerow([i, f"{x:.5f}", f"ОШИБКА: {val[1]}"])
                else:
                    writer.writerow([i, f"{x:.5f}", f"{val:.6f}"])
            writer.writerow([])
            writer.writerow([f"Функция: {func_descr}"])
            writer.writerow([f"Отрезок: [{a}, {b}], шагов: {n}, метод: {method_name}"])
            writer.writerow([f"Интеграл: {integral:.6f}"])
        print("Сохранено в result.csv")
    elif choice == "2":
        with open("result.txt", "w", encoding="utf-8") as file:
            file.write("Калькулятор интегралов — отчёт\n")
            file.write(f"Функция: {func_descr}\n")
            file.write(f"Отрезок: [{a}, {b}]\n")
            file.write(f"Число шагов: {n}, метод: {method_name}\n")
            file.write(f"Интеграл: {integral:.6f}\n\n")
            file.write(f"{'i':>5} | {'x':>12} | {'f(x)':>14}\n")
            file.write("-" * 37 + "\n")
            for i, (x, val) in enumerate(points):
                if isinstance(val, tuple):
                    file.write(f"{i:>5} | {x:>12.5f} | {'ОШИБКА: ' + val[1]:>14}\n")
                else:
                    file.write(f"{i:>5} | {x:>12.5f} | {val:>14.6f}\n")
        print("Сохранено в result.txt")


def main():
    print("=" * 50)
    print("   Калькулятор интегралов с таблицей результатов")
    print("=" * 50)

    func_descr, f = choose_function()

    a = input_float("Нижняя граница a: ")
    while True:
        b = input_float("Верхняя граница b: ")
        if b > a:
            break
        print("Верхняя граница должна быть больше нижней")

    n = input_int("Число шагов N: ")
    method = choose_method()
    method_name = next(name for name, m in METHODS.values() if m == method) if False else \
        [name for name, m in METHODS.values() if m == method][0]

    integral, points, n = integrate(f, a, b, n, method)

    print()
    print_table(points)
    print("-" * 37)
    print(f"Метод: {method_name}")
    print(f"Интеграл f(x) на [{a}, {b}] = {integral:.6f}")

    ref = input("Введите эталонное значение (Enter — пропустить): ").strip()
    if ref:
        try:
            ref_value = float(ref.replace(",", "."))
            print(f"Погрешность: {abs(integral - ref_value):.6f}")
        except ValueError:
            print("Эталон не распознан, пропускаю")

    save_result(points, integral, func_descr, a, b, n, method_name)


if __name__ == "__main__":
    main()
